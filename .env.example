# Meta Model API. Create a key at https://dev.meta.ai and keep it only in .env.
MODEL_API_KEY=

# OpenAI-compatible base URL for Muse Spark.
META_BASE_URL=https://api.meta.ai/v1
SPARK_MODEL=muse-spark-1.3
VOICE_MODEL=muse-voice-transcribe-1.0

# Muse Spark Open is not hosted on Meta Model API. Point this at Baseten or Modal
# after those credits are approved. Leave the base URL empty to fall back to Muse Spark.
OPEN_WEIGHT_BASE_URL=
OPEN_WEIGHT_API_KEY=
OPEN_WEIGHT_MODEL=meta-models/muse-spark-open-1026

# Every model call sets max_tokens. Ceilings are in tokens until API prices are confirmed.
MAX_OUTPUT_TOKENS=4096
RUN_TOKEN_CEILING=200000
PROJECT_TOKEN_CEILING=2000000

SANDBOX_IMAGE=kiln-sandbox:latest
SANDBOX_TIMEOUT_SECONDS=120
SANDBOX_MEMORY=512m
SANDBOX_CPUS=1.0
